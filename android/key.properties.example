# PhiksNiyar Android Release Signing Configuration Template
# COPY this file to android/key.properties (which is git-ignored)
# NEVER commit your actual passwords or keys to source control!

storeFile=C:/path/to/secure/phiksniyar-upload-key.jks
storePassword=YourSecretKeystorePasswordHere
keyAlias=upload
keyPassword=YourSecretKeyPasswordHere
