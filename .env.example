# ==============================================================================
# FixNear (Chilakaluripet Marketplace) - Production Environment Configuration
# ==============================================================================
# Instructions:
# 1. For local development, copy this file to .env.local
# 2. For cloud deployment (Railway, Render, Fly.io, Vercel, DigitalOcean, VPS),
#    populate these variables in your platform's Environment Variables dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://fixnear.in

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 32+ character random secret:
# openssl rand -base64 32
JWT_SECRET=replace-with-a-secure-32-char-random-key-in-production

# Restrict demo/test account persona switching in production (true = enabled, false = disabled)
ALLOW_DEMO_PERSONAS=false
NEXT_PUBLIC_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 3. PRODUCTION DATABASE STORAGE
# ------------------------------------------------------------------------------
# FixNear supports two deployment database topologies:
#
# TOPOLOGY A: Persistent Volume Container (Docker / Railway / Render / Fly.io / VPS) [RECOMMENDED]
# Sub-millisecond queries with zero external network latency using WAL SQLite.
# Mount a persistent volume at /app/data so data survives reboots and container redeploys.
DATA_DIR=/app/data
DATABASE_PATH=/app/data/fixnear.db

# TOPOLOGY B: Cloud Managed PostgreSQL (Supabase / Neon / AWS RDS / Neon Serverless)
# For serverless platforms like Vercel Lambda where local filesystem is ephemeral.
# Initialize using the included schema.sql.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/fixnear?sslmode=require

# ------------------------------------------------------------------------------
# 4. SMS OTP GATEWAY (Indian Mobile Verification)
# ------------------------------------------------------------------------------
# In production, users log in using real 6-digit OTP sent to their +91 mobile.
# Configure at least ONE of the following gateways:

# Option A: Fast2SMS (Popular for Indian DLT & Quick Transactional OTPs)
FAST2SMS_API_KEY=

# Option B: Twilio SMS (Global carrier-grade SMS dispatch)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 5. PAYMENTS & RAZORPAY GATEWAY
# ------------------------------------------------------------------------------
# Platform UPI details for direct QR & Intent payments
PLATFORM_UPI_VPA=fixnear.payments@okhdfcbank
PLATFORM_COMMISSION_PERCENT=10.0

# Live Razorpay credentials (from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. EXTERNAL AI & INTELLIGENT MATCHING (Optional)
# ------------------------------------------------------------------------------
# FixNear includes a built-in offline local NLP and hybrid matching engine that runs
# with zero external dependencies. If you wish to use Google Gemini or OpenAI for
# advanced multi-lingual reasoning:
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 7. CUSTOMER SUPPORT & CONTACT DETAILS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_PHONE=+918647254999
NEXT_PUBLIC_SUPPORT_WHATSAPP=+918647254999
NEXT_PUBLIC_SUPPORT_EMAIL=support@fixnear.in
